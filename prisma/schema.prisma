// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Authentication Table
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  expenses            Expense[]
  categories          Category[]
  budgets             Budget[]
  lendingRecords      LendingRecord[]
  companyMoneyRecords CompanyMoneyRecord[]
  settings            UserSettings?

  @@map("users")
}

// Categories for Expenses
model Category {
  id     String  @id @default(cuid())
  userId String  @map("user_id")
  name   String
  color  String? // Hex color code

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@map("categories")
}

// Main Expenses Table
model Expense {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  categoryId   String?  @map("category_id")
  itemName     String   @map("item_name")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity     Decimal  @db.Decimal(10, 3)
  unit         String
  totalPrice   Decimal  @map("total_price") @db.Decimal(12, 2)
  expenseDate  DateTime @map("expense_date") @db.Date
  description  String?
  billImageUrl String?  @map("bill_image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  BudgetExpenseToPerson BudgetExpenseToPerson[]

  @@index([userId], map: "idx_expenses_user_id")
  @@index([expenseDate], map: "idx_expenses_date")
  @@index([categoryId], map: "idx_expenses_category")
  @@map("expenses")
}

// Budget Management
model Budget {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  totalBudget  Decimal  @map("total_budget") @db.Decimal(12, 2)
  budgetPeriod String   @map("budget_period") // 'daily', 'weekly', 'monthly'
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetExpenseToPersons BudgetExpenseToPerson[]

  @@index([userId], map: "idx_budget_user_id")
  @@index([isActive], map: "idx_budget_active")
  @@map("budgets")
}

// Budget Expense to Persons (for tracking money given to people from budget)
model BudgetExpenseToPerson {
  id          String  @id @default(cuid())
  budgetId    String  @map("budget_id")
  expenseId   String? @map("expense_id") // Add this field
  personName  String  @map("person_name")
  amount      Decimal @db.Decimal(12, 2)
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  budget  Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull) // Add this relation

  @@map("budget_expense_to_persons")
}

// Lending Records (Money given to people)
model LendingRecord {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  personName     String   @map("person_name")
  amountTaken    Decimal  @map("amount_taken") @db.Decimal(12, 2)
  amountReturned Decimal  @default(0) @map("amount_returned") @db.Decimal(12, 2)
  lendingDate    DateTime @map("lending_date") @db.Date
  description    String?
  isSettled      Boolean  @default(false) @map("is_settled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_lending_user_id")
  @@index([personName], map: "idx_lending_person")
  @@index([isSettled], map: "idx_lending_settled")
  @@map("lending_records")
}

// Company Money Records (Money from company or business)
model CompanyMoneyRecord {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  companyName     String   @map("company_name")
  amountReceived  Decimal  @map("amount_received") @db.Decimal(12, 2)
  amountReturned  Decimal  @default(0) @map("amount_returned") @db.Decimal(12, 2)
  transactionDate DateTime @map("transaction_date") @db.Date
  description     String?
  isSettled       Boolean  @default(false) @map("is_settled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_company_money_user_id")
  @@index([companyName], map: "idx_company_money_company")
  @@map("company_money_records")
}

// User Settings
model UserSettings {
  id            String @id @default(cuid())
  userId        String @unique @map("user_id")
  dashboardView String @default("today") @map("dashboard_view") // 'today', 'week', 'month'
  currency      String @default("PKR")
  theme         String @default("light") // 'light', 'dark'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Authentication Table
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  expenses            Expense[]
  categories          Category[]
  budgets             Budget[]
  lendingRecords      LendingRecord[]
  companyMoneyRecords CompanyMoneyRecord[]
  settings            UserSettings?
  messMembers         MessMember[]
  messContributions   MessContribution[]
  messExpenses        MessExpense[]
  flourPurchases      FlourPurchase[]
  flourConsumptions   FlourConsumption[]
  rotiRecords         RotiRecord[]
  cookPayments        CookPayment[]
  teaRecords          TeaRecord[]
  messAuditEntries    MessAuditEntry[]

  @@map("users")
}

// Categories for Expenses
model Category {
  id     String  @id @default(cuid())
  userId String  @map("user_id")
  name   String
  color  String? // Hex color code

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@map("categories")
}

// Main Expenses Table
model Expense {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  categoryId   String?  @map("category_id")
  itemName     String   @map("item_name")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity     Decimal  @db.Decimal(10, 3)
  unit         String
  totalPrice   Decimal  @map("total_price") @db.Decimal(12, 2)
  expenseDate  DateTime @map("expense_date") @db.Date
  description  String?
  billImageUrl String?  @map("bill_image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  BudgetExpenseToPerson BudgetExpenseToPerson[]

  @@index([userId], map: "idx_expenses_user_id")
  @@index([expenseDate], map: "idx_expenses_date")
  @@index([categoryId], map: "idx_expenses_category")
  @@map("expenses")
}

// Budget Management
model Budget {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  totalBudget  Decimal  @map("total_budget") @db.Decimal(12, 2)
  budgetPeriod String   @map("budget_period") // 'daily', 'weekly', 'monthly'
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetExpenseToPersons BudgetExpenseToPerson[]

  @@index([userId], map: "idx_budget_user_id")
  @@index([isActive], map: "idx_budget_active")
  @@map("budgets")
}

// Budget Expense to Persons (for tracking money given to people from budget)
model BudgetExpenseToPerson {
  id          String  @id @default(cuid())
  budgetId    String  @map("budget_id")
  expenseId   String? @map("expense_id") // Add this field
  personName  String  @map("person_name")
  amount      Decimal @db.Decimal(12, 2)
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  budget  Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull) // Add this relation

  @@map("budget_expense_to_persons")
}

// Lending Records (Money given to people)
model LendingRecord {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  personName     String   @map("person_name")
  amountTaken    Decimal  @map("amount_taken") @db.Decimal(12, 2)
  amountReturned Decimal  @default(0) @map("amount_returned") @db.Decimal(12, 2)
  lendingDate    DateTime @map("lending_date") @db.Date
  description    String?
  isSettled      Boolean  @default(false) @map("is_settled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_lending_user_id")
  @@index([personName], map: "idx_lending_person")
  @@index([isSettled], map: "idx_lending_settled")
  @@map("lending_records")
}

// Company Money Records (Money from company or business)
model CompanyMoneyRecord {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  companyName     String   @map("company_name")
  amountReceived  Decimal  @map("amount_received") @db.Decimal(12, 2)
  amountReturned  Decimal  @default(0) @map("amount_returned") @db.Decimal(12, 2)
  transactionDate DateTime @map("transaction_date") @db.Date
  description     String?
  isSettled       Boolean  @default(false) @map("is_settled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_company_money_user_id")
  @@index([companyName], map: "idx_company_money_company")
  @@map("company_money_records")
}

// User Settings
model UserSettings {
  id            String @id @default(cuid())
  userId        String @unique @map("user_id")
  dashboardView String @default("today") @map("dashboard_view") // 'today', 'week', 'month'
  currency      String @default("PKR")
  theme         String @default("light") // 'light', 'dark'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model MessMember {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  name      String
  phone     String    @default("")
  joinedAt  DateTime  @map("joined_at")
  leftAt    DateTime? @map("left_at")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions MessContribution[]
  messExpenses  MessExpense[]

  @@index([userId])
  @@map("mess_members")
}

model MessContribution {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  memberId  String   @map("member_id")
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  member MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memberId])
  @@map("mess_contributions")
}

model MessExpense {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  purchasedById String?  @map("purchased_by_id")
  date          DateTime @db.Date
  item          String
  category      String
  quantity      Decimal  @db.Decimal(10, 3)
  unit          String
  unitPrice     Decimal? @map("unit_price") @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(12, 2)
  notes         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchasedBy MessMember? @relation(fields: [purchasedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([purchasedById])
  @@map("mess_expenses")
}

model FlourPurchase {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  memberId    String    @map("member_id")
  date        DateTime  @db.Date
  quantityKg  Decimal   @map("quantity_kg") @db.Decimal(10, 3)
  ratePerKg   Decimal   @map("rate_per_kg") @db.Decimal(12, 2)
  totalAmount Decimal   @map("total_amount") @db.Decimal(12, 2)
  note        String    @default("")
  status      String    @default("open")
  createdAt   DateTime  @default(now()) @map("created_at")
  endedAt     DateTime? @map("ended_at")

  purchasedKg          Decimal? @map("purchased_kg") @db.Decimal(10, 3)
  carryoverKg          Decimal? @map("carryover_kg") @db.Decimal(10, 3)
  carryoverTransferred Boolean  @default(false) @map("carryover_transferred")
  endingFlourUsedKg    Decimal? @map("ending_flour_used_kg") @db.Decimal(10, 3)
  endingRotiCount      Int?     @map("ending_roti_count")
  flourPerRotiGrams    Decimal? @map("flour_per_roti_grams") @db.Decimal(10, 3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("flour_purchases")
}

model FlourConsumption {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  date       DateTime @db.Date
  quantityKg Decimal  @map("quantity_kg") @db.Decimal(10, 3)
  note       String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("flour_consumptions")
}

model RotiRecord {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  date        DateTime @db.Date
  mealTime    String   @map("meal_time")
  batchId     String   @map("batch_id")
  flourKg     Decimal  @map("flour_kg") @db.Decimal(10, 3)
  rotiCount   Int      @map("roti_count")
  ratePerRoti Decimal  @map("rate_per_roti") @db.Decimal(12, 2)
  cookingFee  Decimal  @map("cooking_fee") @db.Decimal(12, 2)
  cookName    String   @map("cook_name")
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("roti_records")
}

model CookPayment {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  expenseId   String?  @map("expense_id")
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  paymentType String   @map("payment_type")
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cook_payments")
}

model TeaRecord {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  date          DateTime @db.Date
  milkQuantity  Decimal  @map("milk_quantity") @db.Decimal(10, 3)
  milkUnit      String   @map("milk_unit")
  milkCost      Decimal  @map("milk_cost") @db.Decimal(12, 2)
  teaQuantity   Decimal  @map("tea_quantity") @db.Decimal(10, 3)
  teaUnit       String   @map("tea_unit")
  teaCost       Decimal  @map("tea_cost") @db.Decimal(12, 2)
  sugarQuantity Decimal  @map("sugar_quantity") @db.Decimal(10, 3)
  sugarUnit     String   @map("sugar_unit")
  sugarCost     Decimal  @map("sugar_cost") @db.Decimal(12, 2)
  cups          Int
  notes         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tea_records")
}

model MessAuditEntry {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  timestamp  DateTime @default(now())
  details    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mess_audit_entries")
}
